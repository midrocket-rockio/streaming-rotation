{
  "expo": {
    "name": "Streaming Rotation",
    "slug": "streaming-rotation",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "streaming-rotation",
    "newArchitect": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.midrocket.streaming-rotation",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Esta app te notifica sobre cancelaciones y reactivaciones de tus servicios de streaming.",
        "GADApplicationIdentifier": "ca-app-pub-3940256099942544~1458002511",
        "NSAdvertisingAttributionReportEndpoint": "https://appsflyer.com/api/v2/attribution"
      },
      "privacyManifests": {
        "DSPrivacyManifests": {
          "DSPrivacyManifestsPath": "./ios/PrivacyInfo.xcprivacy"
        }
      },
      "buildNumber": "1.3.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.midrocket.streamingrotation",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544/6300978111",
          "iosAppId": "ca-app-pub-3940256099942544/2934735716"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "midrocket-rockio",
    "projectId": "midrocket-streaming-rotation"
  }
}
